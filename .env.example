# ==========================================
# Fish Market Application Environment Config Template
# ==========================================

# Database Type: mysql, postgresql (or pgsql), sqlite
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fishmarket
DB_USER=fishmarket_user
DB_PASSWORD=fishmarket_pass

# Optional Full JDBC URL:
DB_URL=jdbc:mysql://localhost:3306/fishmarket?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# ==========================================
# Redis In-Memory Cache Configuration
# ==========================================
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TIMEOUT=2000
REDIS_TTL_SECONDS=300
